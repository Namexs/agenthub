{
  "name": "agenthub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20 <25",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev": "pnpm --filter @agenthub/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "contracts:build": "pnpm --filter @agenthub/contracts build",
    "contracts:test": "pnpm --filter @agenthub/contracts test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.12.2",
    "@typescript-eslint/parser": "8.12.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@coinbase/wallet-sdk": "4.4.0",
      "abitype@1.0.6": "1.2.3",
      "postcss@8.4.31": "8.5.33",
      "vite": "6.4.6",
      "ws@8": "8.23.0",
      "glob@10.3.10": "10.5.0",
      "decode-uri-component@0.2.2": "0.5.1"
    }
  }
}
