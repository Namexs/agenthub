# AGENTHUB environment — PLACEHOLDERS ONLY. Never commit real keys.
# Forge variables (DEPLOYER_PRIVATE_KEY, ADMIN_MULTISIG, QUEST_CREATOR,
# PAUSER, VERIFIER, AGENT_ID_ADDRESS, SAFE_*, CONFIRM_*): forge reads
# them from the shell environment or from a `.env` file in
# packages/contracts/ (gitignored) — forge does NOT read `.env.local`.
# Next.js variables (NEXT_PUBLIC_*): copy those into apps/web/.env.local.
# See docs/DEPLOYMENT.md.

# --- Network ---
# 97 = BSC Testnet (staging/dev), 56 = BNB Smart Chain mainnet (production target)
NEXT_PUBLIC_CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# Fallback (Phase H: the binance.org endpoint timed out repeatedly from the
# build VM on 2026-11-19; publicnode answered in ~2.5s):
# BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC_URL=https://bsc-dataseed1.binance.org

# --- Agent ID ---
# Mainnet official: 0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
# Testnet/local: address of the deployed MockAgentId (see packages/contracts/script)
NEXT_PUBLIC_AGENT_ID_ADDRESS=

# --- AGENTHUB contracts (filled after deployment; empty = not deployed) ---
NEXT_PUBLIC_AGENT_GATE_ADDRESS=
NEXT_PUBLIC_QUEST_MANAGER_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_ACHIEVEMENT_ADDRESS=
# First deployment block (event queries start here; empty = config error
# once contracts are configured)
NEXT_PUBLIC_DEPLOY_BLOCK=

# --- WalletConnect (optional, Phase 2) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Deployment (Phase 2 only; NEVER commit a real key) ---
# Deployer key for forge scripts. Use a dedicated deployer wallet, funded minimally.
DEPLOYER_PRIVATE_KEY=
# Admin multisig (REQUIRED): a genuine Safe on the target chain, threshold >= 2.
# Validated on-chain before anything deploys (see docs/DEPLOYMENT_PLAN.md §5.1).
ADMIN_MULTISIG=
# Quest creator (REQUIRED): a genuine Safe on the target chain,
# threshold >= 2 (2-of-3 recommended). Validated on-chain with the
# same check as ADMIN_MULTISIG — an EOA or non-Safe reverts the
# deploy (PH7-M03). Use a Safe DISTINCT from the admin multisig.
QUEST_CREATOR=
# Pauser (optional): PAUSER_ROLE. Unset = admin multisig (production default).
PAUSER=
# First verifier (optional): VERIFIER_ROLE at deploy time. Can be granted later via timelock.
VERIFIER=
# Agent ID contract (optional): unset on 97/31337 = deploy MockAgentId.
# On mainnet MUST be 0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F.
# Leave UNSET on testnet unless you have a documented reason.
AGENT_ID_ADDRESS=
# Testnet broadcast guard (REQUIRED on chain 97): must be "true" or
# the deploy script reverts before broadcasting — symmetric with
# CONFIRM_MAINNET_DEPLOY (PH7-M05). Required even for a dry-run
# simulation (the guard cannot tell simulation from broadcast).
CONFIRM_TESTNET_DEPLOY=
# Mainnet broadcast guard (REQUIRED on chain 56): must be "true" or
# the deploy script reverts before broadcasting.
CONFIRM_MAINNET_DEPLOY=
# Local chain (31337) ONLY: expected Safe singleton + proxy codehash
# for the explicit validation path (canonical Safes are not deployed
# locally). MUST be unset on 56/97 — an explicit value reverts.
SAFE_SINGLETON=
SAFE_PROXY_CODEHASH=
# BscScan API key for source verification (testnet + mainnet)
BSCSCAN_API_KEY=
