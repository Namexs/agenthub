# AGENTHUB environment — PLACEHOLDERS ONLY. Never commit real keys.
# Copy to .env.local and fill in. See docs/DEPLOYMENT.md.

# --- Network ---
# 97 = BSC Testnet (staging/dev), 56 = BNB Smart Chain mainnet (production target)
NEXT_PUBLIC_CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC_URL=https://bsc-dataseed1.binance.org

# --- Agent ID ---
# Mainnet official: 0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
# Testnet/local: address of the deployed MockAgentId (see packages/contracts/script)
NEXT_PUBLIC_AGENT_ID_ADDRESS=

# --- AGENTHUB contracts (filled after deployment; empty = not deployed) ---
NEXT_PUBLIC_AGENT_GATE_ADDRESS=
NEXT_PUBLIC_QUEST_MANAGER_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_ACHIEVEMENT_ADDRESS=

# --- WalletConnect (optional, Phase 2) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Deployment (Phase 2 only; NEVER commit a real key) ---
# Deployer key for forge scripts. Use a dedicated deployer wallet, funded minimally.
DEPLOYER_PRIVATE_KEY=
# BscScan API key for source verification (testnet + mainnet)
BSCSCAN_API_KEY=
